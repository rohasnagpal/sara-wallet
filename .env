# ══════════════════════════════════════════════════════════════════════════════
#  SARA — Configuration
#  Copy this file to .env.local and fill in your values. .env.local is where
#  the app actually reads its config from, and it's gitignored — this file
#  (.env) is just the tracked template, safe to commit.
# ══════════════════════════════════════════════════════════════════════════════

# ── AI (required) ─────────────────────────────────────────────────────────────
# Sara connects to AI models through OpenRouter (openrouter.ai) — one API key,
# hundreds of models to choose from (GPT, Claude, Gemini, Llama, and more).
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sara.db

# ── Market Data (optional) ───────────────────────────────────────────────────
# COINGECKO_API_KEY=CG-...              # higher rate limits: coingecko.com/api
# ALCHEMY_API_KEY=...                   # ERC-20 token balances: alchemy.com

# ── EVM RPC endpoints (optional — falls back to public RPCs if blank) ────────
# ETH_RPC=
# ARB_RPC=
# BASE_RPC=
# POLY_RPC=
# OP_RPC=

# ── BlockchainProof (credential-free public checkout) ────────────────────────
# No API key is used. Each user authorizes exactly 1 native USDC from their own
# Sara wallet on Polygon; BlockchainProof sponsors the POL gas.
BLOCKCHAINPROOF_API_URL=https://api.blockchainproof.org
BLOCKCHAINPROOF_CHAIN_ID=137
BLOCKCHAINPROOF_USDC_CONTRACT=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# Optional safety pin for a known BlockchainProof payment receiver address.
# BLOCKCHAINPROOF_RECEIVER_ADDRESS=0x...

# ── bName registration (optional) ────────────────────────────────────────────
# Buy a name like "rohas.sara" linked to your wallet. Requires a separately
# deployed registrar service.
# SARA_NAME_REGISTRAR_ADDRESS=
# SARA_NAME_LOG_ADDRESS=
# SARA_NAME_SERVICE_URL=
# SARA_NAME_REGISTRATION_FEE=10

# ── Contract source verification (optional) ─────────────────────────────────
# When set, tokens deployed through the token creator (Tools -> Tokens) are
# automatically submitted for source verification on PolygonScan/Etherscan
# (via Etherscan's v2 API, same key works across all supported networks)
# right after they confirm on-chain, so they show up as verified instead of
# raw bytecode. Requires `forge` (Foundry) installed. Get a key at
# https://etherscan.io/apidashboard - no per-chain key needed.
# POLYGONSCAN_API_KEY=
